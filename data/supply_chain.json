  "_metadata": {
    "description": "Expanded semiconductor + automotive global supply chain graph. Replaces mockData.json.",
    "data_provenance": {
      "grounded_in_real_data": [
        "transit_time_days — based on 2025-2026 freight industry benchmarks (SeaRates, Freightos, Port Economics & Management, GoFreight maritime disruption reports)",
        "topology — actual chokepoints (Strait of Malacca, Suez Canal, Panama Canal) and real port/manufacturing hub locations (TSMC Hsinchu, Penang OSAT hub, Kaohsiung, Singapore, Rotterdam, LA/Long Beach, Savannah)"
      ],
      "estimated_illustrative": [
        "buffer_days — typical industry inventory-buffer ranges (chip fabs run lean ~15-20 days; auto OEMs run deeper ~25-30 days under post-2021 chip-shortage policy), not any single company's disclosed figure",
        "volume_weight — assumed share of a target node's modeled throughput contributed by that edge; real values should come from customs/trade-flow data (e.g. UN Comtrade, ImportGenius) if you want this to be defensible",
        "risk_score — this is the field your agent pipeline (eventParser.py + Groq) should be populating dynamically from live news. The values below are 2026 baseline placeholders, elevated where current conditions warrant it (e.g. Suez still running below pre-2023 throughput; Panama Canal still recovering from 2023-24 drought restrictions).",
        "alt_route_cost / buffer_reduction_days — cost premiums are directionally grounded in real, widely-reported detour economics (e.g. Cape of Good Hope reroutes during Red Sea disruptions, Panama landbridge rail during the 2023-24 drought restrictions), but exact percentages are illustrative estimates, not sourced from a specific carrier's rate card. Only added to nodes where a real, commonly-used alternate route or source genuinely exists — not every node has one."
      ]
    },
    "last_baseline_review": "2026-07"
  },
